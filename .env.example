# Copy to .env (repo root) and adjust. Never commit .env.

# MySQL connection used by the backend (dev user created by database/init/000_create_database.sql)
DB_URL=mysql+pymysql://holiday:holiday@localhost:3306/holiday

# Data pack and SQL folders (defaults: <repo>/data and <repo>/database)
# DATA_DIR=./data
# DATABASE_DIR=./database

API_PORT=8000
WEB_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# true = on startup, apply database/schema/*.sql and seed the catalog tables from data/catalog
DB_AUTO_INIT=true

# Docker only: MySQL root password for the mysql container
MYSQL_ROOT_PASSWORD=rootpass
