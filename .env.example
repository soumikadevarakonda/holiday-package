# ==============================================================================
# Build My Holiday - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# MySQL Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=build_my_holiday

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30

# Optional: Full Database URL Override
# If set, this overrides DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/build_my_holiday?charset=utf8mb4
